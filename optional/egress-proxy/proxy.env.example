# /etc/paseo-workstation/proxy.env —— 由包装脚本和 paseo@ 服务加载的统一代理变量
HTTP_PROXY=http://127.0.0.1:17899
HTTPS_PROXY=http://127.0.0.1:17899
ALL_PROXY=http://127.0.0.1:17899
http_proxy=http://127.0.0.1:17899
https_proxy=http://127.0.0.1:17899
all_proxy=http://127.0.0.1:17899
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1
